{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanata",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // 秘密ではないので設定に置く。Public Key / Bot Token / 自分の Discord ユーザー ID は
  // `wrangler secret put` 側 (README 参照)。
  "vars": {
    "DISCORD_APPLICATION_ID": "1543076100442300506"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kanata-database-prod",
      "database_id": "4cd83b57-23a7-4cbc-8e3f-7d403dff4455",
      "migrations_dir": "migrations"
    }
  ]
}
